# Qualys secrets stay local in .env or exported environment variables only.
# Exported shell variables override matching values from .env.
# For basic auth, set QUALYS_USERNAME and QUALYS_PASSWORD.
# For token auth, set QUALYS_ACCESS_TOKEN.

## Copy this file to .env and set the gateway for your Qualys service region.
QUALYS_BASE_URL=
QUALYS_USERNAME=
QUALYS_PASSWORD=
QUALYS_ACCESS_TOKEN=
